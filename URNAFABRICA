def field(row: pd.Series, cols: dict, key: str) -> str:
    """Lê um campo da linha usando a coluna resolvida; devolve '' se não existir."""
    col = cols.get(key)
    if not col:
        return ""
    value = row.get(col, "")
    return "" if pd.isna(value) else str(value).strip()


_URL_RE = re.compile(r"https?://[^\s<>\"']+", re.IGNORECASE)

# Rótulo do botão conforme o domínio (a ordem importa: mais específico primeiro).
_LINK_LABELS = {
    "music.youtube.com": "🎵 YouTube Music",
    "youtube.com": "▶️ YouTube",
    "youtu.be": "▶️ YouTube",
    "open.spotify.com": "🎧 Spotify",
    "spotify.com": "🎧 Spotify",
    "instagram.com": "📸 Instagram",
    "deezer.com": "🎧 Deezer",
    "music.apple.com": "🍎 Apple Music",
    "soundcloud.com": "☁️ SoundCloud",
    "bandcamp.com": "🎸 Bandcamp",
    "linktr.ee": "🔗 Linktree",
}


def extract_links(value: str, kind: str = "generic") -> list[str]:
    """
    Extrai links http(s) de um campo de texto livre do Forms. Exemplos reais:
      "Spotify: https://open.spotify.com/x  Youtube: https://youtu.be/y"  -> 2 links
      "@kankrahc" / "Bandaghon" (kind="instagram")                         -> perfil
      "linktr.ee/kankra"                                                   -> https://linktr.ee/kankra
    Só devolve URLs http(s). Texto sem nenhum link reconhecível -> [].
    """
    value = value.strip()
    if not value:
        return []

    urls = [u.rstrip(".,;:)") for u in _URL_RE.findall(value)]
    if urls:
        return list(dict.fromkeys(urls))  # sem repetidos, mantendo a ordem

    if kind == "instagram":
        if "instagram.com" in value.lower() and " " not in value:
            return ["https://" + value.lstrip("/")]
        handle = value.lstrip("@").strip("/")
        if re.fullmatch(r"[A-Za-z0-9._]+", handle):
            return [f"https://www.instagram.com/{handle}"]
        return []

    # domínio sem esquema (ex.: "linktr.ee/kankra")
    if re.fullmatch(r"[\w-]+(\.[\w-]+)+(/\S*)?", value):
        return ["https://" + value]
    return []


def link_label(url: str) -> str:
    """Rótulo amigável do botão a partir do domínio do link."""
    host = urlparse(url).netloc.lower().removeprefix("www.")
    for domain, label in _LINK_LABELS.items():
        if host == domain or host.endswith("." + domain):
            return label
    return f"🔗 {host or 'Link'}"


def render_header(row: pd.Series, cols: dict) -> None:
    col_img, col_info = st.columns([1, 2.5], gap="large")

    with col_img:
        foto_original = field(row, cols, "foto_promo")
        foto_conteudo = convert_drive_image_url(foto_original)
        if foto_conteudo:
            st.image(foto_conteudo, use_container_width=True)
        elif foto_original:
            erro = st.session_state.get(
                "_last_image_error", "Não foi possível carregar a imagem."
            )
            st.warning(f"⚠️ {erro}")
        else:
            st.info("Sem foto promocional cadastrada.")

    with col_info:
        nome = html.escape(field(row, cols, "nome_da_banda") or "Banda sem nome")
        st.markdown(f'<div class="band-name">{nome}</div>', unsafe_allow_html=True)

        links = extract_links(field(row, cols, "instagram_da_banda"), kind="instagram")
        links += extract_links(field(row, cols, "streaming_da_banda"))
        links = list(dict.fromkeys(links))

        links_html = "".join(
            f'<a class="link-pill" href="{html.escape(url, quote=True)}" '
            f'target="_blank" rel="noopener noreferrer">{html.escape(link_label(url))}</a>'
            for url in links
        )
        if links_html:
            st.markdown(links_html, unsafe_allow_html=True)


def render_video(row: pd.Series, cols: dict) -> None:
    st.markdown('<div class="section-title">🎬 Vídeo da banda</div>', unsafe_allow_html=True)
    video_url = field(row, cols, "video_da_banda")
    media = convert_media_to_embed(video_url)

    if media["type"] in ("youtube", "direct"):
        st.video(media["url"])
    elif media["type"] == "drive_iframe":
        st.components.v1.iframe(media["url"], height=480)
        st.caption(
            "Se aparecer uma tela pedindo login do Google no player acima, o "
            "vídeo não está compartilhado como 'Qualquer pessoa com o link' "
            "no Drive — ajuste o compartilhamento do arquivo. "
            f"[Abrir vídeo diretamente no Drive]({video_url})"
        )
    else:
        st.warning("Nenhum vídeo cadastrado para esta banda.")


def render_voting_form(
    curator_name: str, banda_nome: str, row: pd.Series, cols: dict, pending_bandas: list[str]
) -> None:
    st.markdown('<div class="section-title">✅ Avaliação</div>', unsafe_allow_html=True)

    # Texto da banda respondendo à pergunta oficial do Forms, em destaque
    # dentro do bloco de avaliação (é um dos critérios de votação).
    resposta_lineup = field(row, cols, "resposta_lineup")
    st.markdown("**📝 Por que a banda acha que merece estar no lineup:**")
    if resposta_lineup:
        st.markdown(f'<div class="lineup-box">{html.escape(resposta_lineup)}</div>', unsafe_allow_html=True)
    else:
        st.info("Nenhuma resposta cadastrada para esta pergunta.")

    with st.form(key=f"vote_form_{banda_nome}"):
        c1, c2 = st.columns(2)
        with c1:
            nota_resposta = st.number_input(
                "Nota da Redação/Resposta",
                min_value=0.0,
                max_value=10.0,
                value=5.0,
                step=0.5,
                help="Referente ao texto exibido acima (proposta de lineup).",
            )
        with c2:
            nota_video = st.number_input(
                "Nota do Vídeo",
                min_value=0.0,
                max_value=10.0,
                value=5.0,
                step=0.5,
                help="Qualidade da performance apresentada no vídeo.",
            )

        submitted = st.form_submit_button("➡️ Enviar Notas e Próxima Banda", use_container_width=True)

    if submitted:
        with st.spinner(f"Salvando notas na aba de {curator_name}..."):
            save_vote_in_curator_sheet(curator_name, banda_nome, nota_resposta, nota_video)
            time.sleep(0.3)  # pequena pausa para garantir a propagação na API
            load_curator_votes(curator_name, force_refresh=True)

        remaining = [b for b in pending_bandas if b != banda_nome]
        st.session_state["current_banda"] = remaining[0] if remaining else None
        st.toast("Notas registradas com sucesso!", icon="✅")
        st.rerun()


# ----------------------------------------------------------------------------
# MAIN
# ----------------------------------------------------------------------------
def main() -> None:
    st.title("🎸 Curadoria de Seletivas de Bandas")

    # Identificação do curador (sidebar). O nome define em qual aba da
    # planilha as notas dele serão gravadas.
    with st.sidebar:
        st.header("⚙️ Painel")
        st.caption(f"versão: {APP_VERSION}")
        curator_name = st.text_input(
            "Seu nome (curador)",
            value=st.session_state.get("curator_name", ""),
            placeholder="Ex: Caio",
            help="Usado para criar/usar sua própria aba de votos na planilha.",
        ).strip()
        st.session_state["curator_name"] = curator_name

    # ------------------------------------------------------------------
    # 1) Dados das bandas (planilha principal)
    # ------------------------------------------------------------------
    try:
        df, sheet_title = load_bands_data()
    except Exception as exc:  # noqa: BLE001
        st.error(
            "Não foi possível carregar a planilha principal. Verifique suas "
            "credenciais em `.streamlit/secrets.toml`/variáveis de ambiente, o "
            "`worksheet_name` e o compartilhamento da planilha com a conta de serviço."
        )
        st.exception(exc)
        return

    if len(df.columns) == 0:
        st.warning(f"A aba '{sheet_title}' está vazia (sem cabeçalho).")
        return

    # ------------------------------------------------------------------
    # 2) Descobre quais colunas reais correspondem a cada campo
    # ------------------------------------------------------------------
    cols = resolve_columns(df.columns)

    with st.sidebar:
        with st.expander("🔎 Colunas detectadas"):
            st.caption(f"Aba lida: **{sheet_title}**")
            for key, col in cols.items():
                st.markdown(f"`{key}` → " + (f"`{col}`" if col else "❌ não encontrada"))

    missing_required = [k for k in REQUIRED_COLUMNS if not cols.get(k)]
    if missing_required:
        st.error(
            f"Não encontrei na aba **{sheet_title}** a(s) coluna(s) obrigatória(s): "
            + ", ".join(f"`{k}`" for k in missing_required)
            + ". Ajuste o `COLUMN_MAP` no topo do `app.py` com o cabeçalho exato "
            "(copie de uma das colunas abaixo) ou confira se `worksheet_name` aponta "
            "para a aba certa."
        )
        st.markdown("**Colunas encontradas nessa aba:**")
        st.code("\n".join(str(c) for c in df.columns))
        return

    if df.empty:
        st.warning("A planilha principal ainda não tem nenhuma resposta.")
        return

    # ------------------------------------------------------------------
    # 3) Curador e aba individual
    # ------------------------------------------------------------------
    if not curator_name:
        st.info("👋 Digite seu nome na barra lateral para começar a avaliar as bandas.")
        return

    erro_nome = validate_curator_name(curator_name, sheet_title)
    if erro_nome:
        st.error(erro_nome)
        return

    try:
        get_or_create_curator_worksheet(curator_name)
    except Exception as exc:  # noqa: BLE001
        st.error(
            f"Não foi possível criar/abrir a aba de '{curator_name}' na planilha. "
            "Verifique se a conta de serviço tem permissão de Editor."
        )
        st.exception(exc)
        return

    # ------------------------------------------------------------------
    # 4) Fila de bandas pendentes para ESTE curador
    # ------------------------------------------------------------------
    nomes = df[cols["nome_da_banda"]].astype(str).str.strip()
    df = df[nomes != ""]
    nomes = nomes[nomes != ""]

    curator_votes = load_curator_votes(curator_name)

    todas_bandas = list(dict.fromkeys(nomes))  # únicos, preservando a ordem
    pending_bandas = [b for b in todas_bandas if b not in curator_votes]

    if st.session_state.get("current_banda") not in pending_bandas:
        st.session_state["current_banda"] = pending_bandas[0] if pending_bandas else None
    current_banda = st.session_state["current_banda"]

    total = len(todas_bandas)
    votadas = total - len(pending_bandas)

    with st.sidebar:
        st.metric("Total de bandas", total)
        st.metric(f"Avaliadas por {curator_name}", votadas)
        st.metric("Pendentes", len(pending_bandas))
        if st.button("🔄 Recarregar dados"):
            load_bands_data(force_refresh=True)
            load_curator_votes(curator_name, force_refresh=True)
            st.rerun()

    if current_banda is None:
        st.balloons()
        st.success(f"🎉 {curator_name}, você já avaliou todas as {total} bandas!")
        return

    st.markdown(
        f'<div class="progress-tag">Banda pendente {votadas + 1} de {total} '
        f"&nbsp;·&nbsp; {len(pending_bandas)} restantes &nbsp;·&nbsp; curador: <b>{html.escape(curator_name)}</b></div>",
        unsafe_allow_html=True,
    )
    st.progress(votadas / total if total else 0)

    row = df[nomes == current_banda].iloc[0]

    render_header(row, cols)
    st.divider()
    render_video(row, cols)
    st.divider()
    render_voting_form(curator_name, current_banda, row, cols, pending_bandas)


if __name__ == "__main__":
    main()
