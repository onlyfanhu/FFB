@st.cache_resource(show_spinner=False)
def get_gspread_client() -> gspread.Client:
    """Cria o cliente gspread autenticado a partir de st.secrets."""
    credentials_info = dict(st.secrets["gcp_service_account"])
    creds = Credentials.from_service_account_info(credentials_info, scopes=SCOPES)
    return gspread.authorize(creds)


@st.cache_resource(show_spinner=False)
def get_spreadsheet() -> gspread.Spreadsheet:
    """Abre a planilha configurada em st.secrets['sheet'] (o arquivo inteiro)."""
    client = get_gspread_client()
    sheet_url = st.secrets["sheet"]["sheet_url"]
    return client.open_by_url(sheet_url)


def get_main_worksheet() -> gspread.Worksheet:
    """Abre a ABA PRINCIPAL (respostas do Forms) configurada em st.secrets."""
    spreadsheet = get_spreadsheet()
    worksheet_name = st.secrets["sheet"].get("worksheet_name")
    if worksheet_name:
        try:
            return spreadsheet.worksheet(worksheet_name)
        except gspread.exceptions.WorksheetNotFound:
            # Nome errado (ex.: nome da TABELA "Form_Responses" em vez do nome
            # da ABA). Cai para a 1ª aba; _load_bands_data_cached ainda tenta
            # achar a aba certa automaticamente.
            pass
    return spreadsheet.sheet1


def _normalize(text: str) -> str:
    """Minúsculas, sem acento e sem pontuação: 'Vídeo da Banda?' -> 'video da banda'."""
    text = unicodedata.normalize("NFKD", str(text)).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", " ", text.lower()).strip()


def resolve_columns(headers) -> dict:
    """
    Descobre qual cabeçalho real da planilha corresponde a cada campo lógico
    de COLUMN_MAP. Retorna {campo: cabeçalho_real ou None}.

    1) Correspondência exata com o valor de COLUMN_MAP (ignorando acento,
       maiúscula e pontuação).
    2) Fallback por palavras-chave (COLUMN_KEYWORDS).
    Uma mesma coluna nunca é atribuída a dois campos.
    """
    headers = list(headers)
    norm = {h: _normalize(h) for h in headers}
    resolved = {key: None for key in COLUMN_MAP}
    used = set()

    for key, wanted in COLUMN_MAP.items():
        for h in headers:
            if h not in used and norm[h] == _normalize(wanted):
                resolved[key] = h
                used.add(h)
                break

    for key, groups in COLUMN_KEYWORDS.items():
        if resolved.get(key):
            continue
        for tokens in groups:
            match = next(
                (
                    h for h in headers
                    if h not in used
                    and all(any(w.startswith(t) for w in norm[h].split()) for t in tokens)
                ),
                None,
            )
            if match:
                resolved[key] = h = match
                used.add(h)
                break

    return resolved


def _make_unique_headers(headers: list) -> list:
    """Dá nome a cabeçalhos vazios e desduplica repetidos (comum em Forms)."""
    seen, result = {}, []
    for i, h in enumerate(headers):
        name = str(h).strip() or f"coluna_{i + 1}"
        if name in seen:
            seen[name] += 1
            name = f"{name} ({seen[name]})"
        else:
            seen[name] = 1
        result.append(name)
    return result


def load_bands_data(force_refresh: bool = False) -> tuple[pd.DataFrame, str]:
    """Carrega a planilha principal. Retorna (DataFrame, título_da_aba_lida)."""
    if force_refresh:
        st.cache_data.clear()
    return _load_bands_data_cached()


def _looks_like_bands_sheet(raw_headers: list) -> bool:
    """
    True se a linha 1 parece ser a de uma aba de inscrições de bandas: precisa
    achar a coluna do nome da banda + pelo menos 3 dos campos conhecidos.
    Abas de curadores (Banda | Nota Resposta | ...) são excluídas de propósito.
    """
    cleaned = [str(h).strip() for h in raw_headers]
    if cleaned[: len(CURATOR_SHEET_HEADERS)] == CURATOR_SHEET_HEADERS:
        return False
    resolved = resolve_columns(_make_unique_headers(cleaned))
    return bool(resolved.get("nome_da_banda")) and sum(1 for v in resolved.values() if v) >= 3


@st.cache_data(ttl=30, show_spinner="Carregando dados das bandas...")
def _load_bands_data_cached() -> tuple[pd.DataFrame, str]:
    worksheet = get_main_worksheet()
    # get_all_values (em vez de get_all_records) não quebra com cabeçalhos
    # vazios/duplicados e não converte textos em números sem avisar.
    values = worksheet.get_all_values()

    # Se a aba configurada não parece ser a das inscrições, procura outra aba
    # da planilha que seja (evita depender de worksheet_name estar certo).
    if not values or not _looks_like_bands_sheet(values[0]):
        for other in get_spreadsheet().worksheets():
            if other.id == worksheet.id:
                continue
            if _looks_like_bands_sheet(other.row_values(1)):
                worksheet, values = other, other.get_all_values()
                break

    if not values:
        return pd.DataFrame(), worksheet.title

    headers = _make_unique_headers(values[0])
    width = len(headers)
    rows = [(r + [""] * width)[:width] for r in values[1:]]  # linhas podem vir com tamanhos diferentes
    df = pd.DataFrame(rows, columns=headers)

    # Remove linhas totalmente vazias.
    if not df.empty:
        df = df[df.apply(lambda r: any(str(v).strip() for v in r), axis=1)].reset_index(drop=True)
    return df, worksheet.title


